# Contact form (Resend) — https://resend.com/api-keys
# Required for the /contact form to send email.
RESEND_API_KEY=re_your_api_key_here

# Where inquiries are delivered (default: voxiantsolutions@gmail.com)
CONTACT_TO_EMAIL=voxiantsolutions@gmail.com

# Sender shown in the inbox. Use onboarding@resend.dev for testing;
# after verifying your domain at Resend, use e.g.:
# RESEND_FROM_EMAIL=Voxiant Solutions <contact@yourdomain.com>
RESEND_FROM_EMAIL=Voxiant Solutions <onboarding@resend.dev>
